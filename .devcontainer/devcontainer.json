{
  "name": "OOP opdrachten",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",

  // Zorg dat poort 8080 toegankelijk is
  "forwardPorts": [8080],

  // Open automatisch in de browser
  "portsAttributes": {
    "8080": {
      "label": "Webserver",
      "onAutoForward": "openBrowser"
    }
  },

  // Start een simpele webserver zodra de container start
  "postCreateCommand": "npx serve -l 8080"
}